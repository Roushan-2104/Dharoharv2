# Dharohar Project Environment Variables Example
# Copy this file to .env and configure your credentials

# PostgreSQL / Supabase Database URL
DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Backend Port
PORT=3000

# Frontend API URL (leave empty in docker for automatic Nginx reverse proxy)
VITE_API_URL=
