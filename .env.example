# Dharohar Project Environment Variables Example
# Copy this file to .env and configure your credentials

# PostgreSQL / Supabase Database URL
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
# Optional: Postgres schema for Dharohar's tables (default dharohar). Create and fill it with: cd backend && npm run setup-db
# DB_SCHEMA=dharohar

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key_here
# Optional: comma-separated models tried in order, and per-call timeout in ms
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest,gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=25000

# Backend Port
PORT=3000

# Optional: comma-separated browser origins allowed to call the API cross-origin
# (default: http://localhost:5173,http://127.0.0.1:5173). Add your deployed site here.
# CORS_ORIGINS=https://your-site.example
# Optional: set to 1 only when the backend sits behind Nginx/another proxy (prod compose does this)
# TRUST_PROXY=1

# Frontend API URL. Leave empty: in Docker and in local dev the /api calls are proxied to the backend.
VITE_API_URL=

# Optional: host port for the production Docker stack (default 80)
# WEB_PORT=8080
